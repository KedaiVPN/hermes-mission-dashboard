[Unit]
Description=Hermes Mission Dashboard
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/hermes-mission-dashboard/backend
Environment="MISSION_DB_PATH=/root/hermes-mission-dashboard/backend/mission.db"
ExecStart=/root/hermes-mission-dashboard/backend/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
